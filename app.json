{
	"expo": {
		"name": "momo-app",
		"slug": "momo-app",
		"version": "1.0.0",
		"backgroundColor": "#0F172A",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "momoapp",
		"userInterfaceStyle": "dark",
		"ios": {
			"bundleIdentifier": "com.momo.app",
			"icon": "./assets/expo.icon",
			"supportsTablet": true
		},
		"android": {
			"package": "com.momo.app",
			"adaptiveIcon": {
				"backgroundColor": "#0F172A",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#0F172A",
					"android": {
						"image": "./assets/images/splash-icon.png",
						"imageWidth": 150
					}
				}
			],
			"expo-secure-store"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "548a5da0-8715-4c1f-b60c-f34d09620ea9"
			}
		},
		"owner": "bfukumori",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/548a5da0-8715-4c1f-b60c-f34d09620ea9"
		}
	}
}
